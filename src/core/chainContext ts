import { AsyncLocalStorage } from "node:async_hooks";
import type { ChainId } from "./chains.js";

// Per-Telegram-update chain context.
//
// index.ts resolves the user's /chain preference in a middleware and runs the
// whole update inside withChainContext(). Every no-arg getPublicClient() /
// getWalletClient() / scanContract() / fetchWalletPortfolio() call then
// resolves to the user's chosen chain via getDefaultChainId() → getContextChain().
// Falls back to the CHAIN env var (then "base") outside any request context
// (background jobs, timers, the watch loop's own notifications).

const storage = new AsyncLocalStorage<ChainId>();

export function withChainContext<T>(
  chain: ChainId,
  fn: () => Promise<T>
): Promise<T> {
  return storage.run(chain, fn);
}

export function getContextChain(): ChainId | undefined {
  return storage.getStore();
}
