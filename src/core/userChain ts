import { prisma } from "../db/client.js";

export type ChainKey = "base" | "robinhood";
export type ChainSelection = ChainKey | "both";

export const CHAIN_KEYS: readonly ChainKey[] = ["base", "robinhood"];
export const CHAIN_SELECTIONS: readonly ChainSelection[] = [
  "base",
  "robinhood",
  "both",
];

export function sanitizeSelection(
  value: string | null | undefined
): ChainSelection {
  return CHAIN_SELECTIONS.includes(value as ChainSelection)
    ? (value as ChainSelection)
    : "base";
}

export async function getUserChainSelection(
  telegramId: bigint
): Promise<ChainSelection> {
  const pref = await prisma.userPreference.findUnique({
    where: { userId: telegramId },
  });
  return sanitizeSelection(pref?.chain);
}

export async function setUserChainSelection(
  telegramId: bigint,
  selection: ChainSelection
): Promise<void> {
  await prisma.userPreference.upsert({
    where: { userId: telegramId },
    update: { chain: selection },
    create: { userId: telegramId, chain: selection },
  });
}

export function getChainsForSelection(
  selection: ChainSelection
): ChainKey[] {
  return selection === "both" ? [...CHAIN_KEYS] : [selection];
}

export function getPrimaryChain(selection: ChainSelection): ChainKey {
  return selection === "robinhood" ? "robinhood" : "base";
}

export function chainBadge(chain: ChainKey): string {
  return chain === "base" ? "⛽" : "🏹";
}

export function chainLabel(chain: ChainKey): string {
  return chain === "base" ? "Base" : "Robinhood Chain";
}

export function selectionLabel(selection: ChainSelection): string {
  switch (selection) {
    case "robinhood":
      return "Robinhood Chain 🏹";
    case "both":
      return "Both chains (Base ⛽ + Robinhood 🏹)";
    default:
      return "Base ⛽";
  }
}
