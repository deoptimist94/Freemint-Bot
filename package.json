{
  "name": "base-auto-mint-bot",
  "version": "2.0.0",
  "description": "Professional NFT Sniper Bot with Mempool Monitoring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && prisma generate",
    "start": "prisma db push --accept-data-loss && node dist/main.js",
    "worker": "node dist/worker.js",
    "dev": "tsx src/main.ts",
    "dev:worker": "tsx src/worker.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bull": "^4.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "grammy": "^1.32.0",
    "ioredis": "^5.3.2",
    "prisma": "^5.22.0",
    "viem": "^2.21.55",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
