generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  telegramId      BigInt   @id
  autoMintEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  wallets        Wallet[]
  mintHistory    MintHistory[]
  watchlist      Watchlist[]
  trackedWallets TrackedWallet[]
  sniperConfig   SniperConfig?
  bypassLogs     BypassLog[]
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              BigInt
  address             String
  encryptedPrivateKey String
  isActive            Boolean  @default(true)
  label               String   @default("")
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@index([userId])
}

model MintHistory {
  id              String   @id @default(cuid())
  userId          BigInt
  contractAddress String
  txHash          String?
  status          String
  timestamp       DateTime @default(now())

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@index([userId])
}

model Watchlist {
  id              String   @id @default(cuid())
  userId          BigInt
  contractAddress String
  addedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@unique([userId, contractAddress])
  @@index([userId])
}

model TrackedWallet {
  id        String   @id @default(cuid())
  userId    BigInt
  address   String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId])
}

model SniperConfig {
  userId      BigInt   @id
  autoCopy    Boolean  @default(false)
  maxSpendEth Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
}

model BypassLog {
  id              String   @id @default(cuid())
  userId          BigInt
  contractAddress String
  strategyId      String
  walletAddress   String
  success         Boolean
  txHash          String?
  error           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@index([userId])
  @@index([contractAddress])
}
